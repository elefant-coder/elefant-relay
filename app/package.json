{
  "name": "elefant-relay-app",
  "productName": "Elefant Relay",
  "version": "0.2.2",
  "description": "Talk with a friend's AI from your Mac or Windows PC — no commands.",
  "author": "Elefant Inc.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "lib": "node scripts/copy-lib.mjs",
    "start": "npm run lib && electron .",
    "dist": "npm run lib && electron-builder --mac dmg --universal",
    "dist:win": "npm run lib && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.elefant.relay",
    "productName": "Elefant Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "chat.mjs",
      "renderer/**",
      "lib/**",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "sign": true,
      "title": "Elefant Relay"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ElefantRelay-Setup-${version}-${arch}.${ext}",
      "shortcutName": "Elefant Relay",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0"
  }
}
