# Copy to harness/release.local.env (ignored by git) and fill in.
NOTARY_PROFILE=your-notarytool-keychain-profile   # xcrun notarytool store-credentials …
# APPLE_KEYCHAIN_PROFILE=                          # defaults to NOTARY_PROFILE (electron-builder notarizes the .app)
# RELEASE_REPO=elefant-coder/elefant-relay
# Landing page to point at the new version (optional): a folder with content.html and deploy/ (a Vercel project)
# LP_DIR=/path/to/lp
# LP_URL=https://example.com
