{
  "name": "elefant-relay",
  "version": "0.2.0",
  "description": "Let your AI ask a friend's AI to do a job — and get just the result back. End-to-end encrypted, outbound-only, works with any MCP client.",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "ai-agents",
    "e2e-encryption",
    "relay",
    "syncthing"
  ],
  "homepage": "https://github.com/elefant-coder/elefant-relay#readme",
  "bugs": {
    "url": "https://github.com/elefant-coder/elefant-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elefant-coder/elefant-relay.git"
  },
  "license": "MIT",
  "author": "Elefant Inc.",
  "type": "module",
  "bin": {
    "elefant-relay": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "relay/worker.ts",
    "relay/wrangler.toml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "relay:dev": "wrangler dev --config relay/wrangler.toml",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
